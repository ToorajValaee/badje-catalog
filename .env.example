DATABASE_URL=postgresql://badje_catalog:CHANGE_ME@host.docker.internal:5432/badje_catalog
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=true
MAX_UPLOAD_MB=200

# Admin sign-in is passwordless OTP for admin@publio.ir.
# These Resend values bootstrap OTP email before you can sign in and manage
# the permanent email settings from /admin/email.
RESEND_API_KEY=
RESEND_FROM_NAME=Publio
RESEND_FROM_EMAIL=publio@badje.ir
RESEND_REPLY_TO=publio@badje.ir

CATALOG_RENDER_DPI=200
CATALOG_WEBP_QUALITY=96
CATALOG_WEBP_LOSSLESS=true

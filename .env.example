DATABASE_URL=postgresql://badje_catalog:CHANGE_ME@host.docker.internal:5432/badje_catalog
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=true
MAX_UPLOAD_MB=200

# One shared email + OTP login is used for both users and the administrator.
# Set the administrator email here. It is not hardcoded in the application.
ADMIN_EMAIL=

# Resend is configured only through runtime environment variables.
RESEND_API_KEY=
RESEND_FROM_NAME=Publio
RESEND_FROM_EMAIL=no-reply@publio.ir
RESEND_REPLY_TO=info@publio.ir

CATALOG_RENDER_DPI=200
CATALOG_WEBP_QUALITY=96
CATALOG_WEBP_LOSSLESS=true

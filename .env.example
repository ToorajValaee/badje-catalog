DATABASE_URL=postgresql://badje_catalog:CHANGE_ME@host.docker.internal:5432/badje_catalog
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=true
MAX_UPLOAD_MB=200

# Raster catalog quality. 200 DPI is a good balance for A4/mobile/desktop.
CATALOG_RENDER_DPI=200
# Used only if lossless=false.
CATALOG_WEBP_QUALITY=96
# true preserves the rendered page pixels without lossy WebP compression.
CATALOG_WEBP_LOSSLESS=true
